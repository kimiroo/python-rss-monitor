# 감시할 RSS 주소
FEED_URL=https://yonsei.ac.kr/bbs/sc/58/rssList.do?row=50

# 키워드: 쉼표 구분 또는 JSON 배열. 하나라도 포함되면 알림 (OR, 대소문자 무시)
# 비워두면 모든 새 글을 알림
#   KEYWORDS=
#   KEYWORDS=장학
#   KEYWORDS=장학, 공모전
#   KEYWORDS=["장학", "AI 아카데미"]
KEYWORDS=장학, 공모전

# 알림 대상 (Apprise URL, 여러 개면 공백 또는 쉼표로 구분). 비워두면 로그로만 출력
# Slack 웹훅 URL은 그대로 넣으면 됨: https://hooks.slack.com/services/T.../B.../XXX
#   끝에 ?footer=no 를 붙이면 메시지 하단 표시줄(봇 이름)이 사라짐
# 다른 서비스 예: discord://ID/TOKEN  tgram://BOT_TOKEN/CHAT_ID  gotify://host/TOKEN  ntfy://topic
# 전체 목록: https://github.com/caronc/apprise/wiki
NOTIFY_URLS=

# 확인 스케줄 (cron: 분 시 일 월 요일), docker-compose.yml 의 TZ 기준
#   */5 * * * *        5분마다
#   */10 9-18 * * 1-5  평일 9~18시, 10분마다
SCHEDULE=*/5 * * * *

# 시작하자마자 한 번 확인할지
RUN_ON_START=true

# 키워드를 찾을 필드: title, description
MATCH_FIELDS=title

# 처음 실행할 때 기존 글도 알릴지 (true/false)
NOTIFY_EXISTING=false
